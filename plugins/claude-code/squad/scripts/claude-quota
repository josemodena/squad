#!/usr/bin/env python3
"""The project's share of the weekly subscription limit.

The rule: a fixed percentage of the weekly limit per day, a cap for the week,
a day boundary at a fixed hour UTC, and carry-forward of unused allowance
inside the week. The last day of the window may spend the whole remaining
limit, so the reserve held back through the week is (100 - cap).

The three numbers come from .claude/squad.local.md:

    quota_daily_percent: 14
    quota_weekly_cap_percent: 85
    sprint_hour_utc: 17

Reads the usage file written by the status-line wrapper, by default
~/.cache/claude-code/usage.json, and prints a verdict: run | suspend | stale |
missing.

    claude-quota            one line for a person
    claude-quota --json     the numbers

Exit code: 0 run, 1 suspend, 2 stale (reading older than --max-age minutes,
default 60), 3 missing.

SQUAD_QUOTA_FORCE=run|suspend|stale overrides the verdict. It exists so that a
session-start hook, a conductor and an eval case can be tested without waiting
for the real numbers to move. It never changes the figures, only the verdict.
"""
import json
import os
import re
import sys
import time
from squad_runtime import apply_policy, settings as runtime_settings
import datetime as dt

DEFAULT_DAILY = 14.0
DEFAULT_CAP = 85.0
DEFAULT_BOUNDARY_HOUR = 17
MAX_AGE_MIN = 60
USAGE_FILE = "~/.cache/claude-code/usage.json"


def find_settings():
    explicit = os.environ.get("SQUAD_SETTINGS")
    if explicit:
        return explicit if os.path.exists(explicit) else None
    for base in (os.environ.get("SQUAD_PROJECT_DIR"), os.environ.get("CLAUDE_PROJECT_DIR")):
        if base:
            candidate = os.path.join(base, ".claude", "squad.local.md")
            if os.path.exists(candidate):
                return candidate
    here = os.getcwd()
    while True:
        candidate = os.path.join(here, ".claude", "squad.local.md")
        if os.path.exists(candidate):
            return candidate
        parent = os.path.dirname(here)
        if parent == here:
            return None
        here = parent


def read_settings():
    """The three numbers this script needs, or the defaults when there is no
    settings file. A missing settings file is not an error here: the quota rule
    has a sensible default and a session start must never fail on it."""
    values = {"daily": DEFAULT_DAILY, "cap": DEFAULT_CAP, "hour": DEFAULT_BOUNDARY_HOUR}
    path = find_settings()
    if not path:
        return values, None
    try:
        text = open(path, encoding="utf-8").read()
    except OSError:
        return values, None
    match = re.match(r"^---\s*\n(.*?)\n(?:---|\.\.\.)\s*(?:\n|$)", text, re.S)
    front = match.group(1) if match else ""
    keys = {
        "quota_daily_percent": ("daily", float),
        "quota_weekly_cap_percent": ("cap", float),
        "sprint_hour_utc": ("hour", int),
    }
    for line in front.splitlines():
        parts = line.split(":", 1)
        if len(parts) != 2:
            continue
        key = parts[0].strip()
        if key not in keys:
            continue
        name, cast = keys[key]
        raw = parts[1].split("#")[0].strip().strip('"').strip("'")
        try:
            values[name] = cast(raw)
        except ValueError:
            pass
    return values, path


def utc(ts):
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc)


def main():
    as_json = "--json" in sys.argv
    max_age = MAX_AGE_MIN
    for i, a in enumerate(sys.argv):
        if a == "--max-age" and i + 1 < len(sys.argv):
            max_age = int(sys.argv[i + 1])

    settings, settings_path = read_settings()
    daily, cap, boundary_hour = settings["daily"], settings["cap"], settings["hour"]
    forced = os.environ.get("SQUAD_QUOTA_FORCE", "").strip()

    path = os.path.expanduser(os.environ.get("SQUAD_USAGE_FILE", USAGE_FILE))
    if not os.path.exists(path):
        if forced in ("run", "suspend", "stale"):
            print(f"{forced}: forced by SQUAD_QUOTA_FORCE, no usage reading available")
            sys.exit({"run": 0, "suspend": 1, "stale": 2}[forced])
        print("missing: no usage reading yet")
        sys.exit(3)
    d = json.load(open(path, encoding="utf-8"))
    week = d.get("seven_day") or {}
    used = round(float(week.get("used_percentage", 0)), 1)
    resets_at = int(week.get("resets_at", 0))
    captured = int(d.get("captured_at", 0))
    now = int(time.time())
    age_min = (now - captured) // 60
    window_start = resets_at - 7 * 86400
    elapsed_days = (now - window_start) / 86400
    day_index = int(elapsed_days) + 1                 # current day included
    # The last day of the window may spend everything that is left: the goal is
    # to reach the reset having used the whole limit, so the cap does not apply
    # on day 7 and the allowance stays 100.
    allowance = min(cap, daily * max(1, min(7, day_index)))
    headroom = round(allowance - used, 1)
    n = utc(now)
    b = n.replace(hour=boundary_hour, minute=0, second=0, microsecond=0)
    if b <= n:
        b += dt.timedelta(days=1)
    verdict = "run" if used < allowance else "suspend"
    if age_min > max_age:
        verdict = "stale"
    if forced in ("run", "suspend", "stale"):
        verdict = forced
    out = {"verdict": verdict, "weekly_used": used, "allowance_to_date": allowance,
           "headroom": headroom, "cap": cap, "daily": daily,
           "day_of_week_window": day_index,
           "window_resets_at": utc(resets_at).strftime("%a %d %b %H:%M UTC"),
           "next_boundary": b.strftime("%a %d %b %H:%M UTC"), "data_age_min": age_min,
           "settings_file": settings_path}
    applied = apply_policy(runtime_settings(settings_path), d, allowance, used, resets_at, captured, now)
    out.update(applied)
    verdict = applied['verdict']
    allowance, headroom = applied['allowance_to_date'], applied['headroom']
    if forced in ('run', 'suspend', 'stale'):
        verdict = forced
        out['verdict'] = forced
    if as_json:
        print(json.dumps(out, indent=2))
    else:
        print(f"{verdict}: weekly {used}% used, allowance to date {allowance}% (day {day_index}), "
              f"headroom {headroom}%, next boundary {out['next_boundary']}, "
              f"reset {out['window_resets_at']}, data age {age_min} min")
    sys.exit({"run": 0, "suspend": 1, "stale": 2}[verdict])


if __name__ == "__main__":
    main()
